 "news": {
  "date": "2026-11-11",
  "asof": "2026-11-12 13:31 UTC",
  "headline": "Chips surge 5.7% on CoreWeave \u2014 then Nvidia falls 8% after hours on a report about its chief executive",
  "standfirst": "The S&P rose 1.31% and the Nasdaq 1.60% as the chip index jumped about 5.7%, led by CoreWeave's raised guidance. After the close Nvidia fell about 8% on a Wall Street Journal report that its board is preparing to remove Jensen Huang. Fed officials kept leaning toward hikes, and Iran said Hormuz stays shut until its demands are met. The book is flat; Q4 is +34.64 realised, heat 0R.",
  "themes": [
   {
    "kicker": "What's next",
    "right": "Thursday: Nvidia's open, claims, Cisco",
    "title": "Nvidia's open, then claims, PPI and Nvidia's results",
