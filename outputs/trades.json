 "lessons": [
  {
   "id": "snow-2026-08-07",
   "trade_ids": [
    "tr_import_gabriel_020",
    "tr_1785692318200_3831"
   ],
   "date": "2026-08-07",
   "title": "SNOW +3.72R / +3.54R — the 40-day hold, in our own words",
   "source": "debrief answered by Gabriel and Aldemar on exit day, before the outcome could rewrite it",
   "what_actually_happened": [
